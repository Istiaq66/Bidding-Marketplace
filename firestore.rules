rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helpers ───────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Auction end time: in the future, and no more than ~13 months out
    // (the create/edit date pickers allow up to 365 days).
    function validEndsAt(ts) {
      return ts is timestamp
        && ts > request.time
        && ts < request.time + duration.value(400, 'd');
    }

    // Product photos must live in the seller's own Supabase folder
    // (`product_images/{uid}/...`, see StorageService). Empty = no photo.
    function validImageUrl(url, uid) {
      return url is string
        && (url == ''
          || url.matches('^https://[a-z0-9]+[.]supabase[.]co/storage/v1/object/public/product_images/'
               + uid + '/[^/]+$'));
    }

    function productPath(productId) {
      return /databases/$(database)/documents/products/$(productId);
    }

    function bidPath(bidId) {
      return /databases/$(database)/documents/bids/$(bidId);
    }

    // ── Users ────────────────────────────────────────────────────────────────
    // Public profile: name, photo, bio. Readable by any signed-in user.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(publicKeys())
        && request.resource.data.get('userId', uid) == uid;
      // Updates may also delete private fields older app versions left on the
      // public doc (UserRepository.migrateLegacyPrivateFields), but the
      // result must hold public fields only.
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(publicKeys().concat(privateKeys()))
        && request.resource.data.keys().hasOnly(publicKeys())
        && request.resource.data.get('userId', uid) == uid;
      allow delete: if isUser(uid);

      function publicKeys() {
        return ['userId', 'name', 'photo', 'profileImage', 'bio', 'updatedAt'];
      }

      // Contact details, push tokens and prefs: owner-only. Cloud Functions
      // (push.ts) read them via the Admin SDK.
      match /private/{docId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && docId == 'profile'
          && request.resource.data.keys().hasOnly(privateKeys().concat(['updatedAt']))
          && request.resource.data.get('fcmTokens', []) is list
          && request.resource.data.get('fcmTokens', []).size() <= 10
          && request.resource.data.get('notificationPrefs', {}) is map;
      }
    }

    function privateKeys() {
      return ['email', 'phone', 'address', 'fcmTokens', 'notificationPrefs'];
    }

    // ── Products ─────────────────────────────────────────────────────────────
    // Lifecycle fields (status, winnerId, endedAt) are written only by the
    // `endAuction` Cloud Function, which bypasses rules via the Admin SDK.
    match /products/{productId} {
      allow read: if true;

      allow create: if signedIn() && isValidNewProduct();

      // A bid (paired with its bid doc, see /bids) or a seller edit while the
      // auction has no bids. No other client update path exists.
      allow update: if signedIn()
        && (isBidUpdate() || isSellerEdit());

      // bidCount can only grow (isBidUpdate), so a product with bids can
      // never be deleted by its seller.
      allow delete: if isUser(resource.data['User Id'])
        && resource.data.get('bidCount', 0) == 0;

      function isValidNewProduct() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'User Id', 'Product Name', 'Product Description',
            'Minimum Bid Price', 'Date', 'Image Url', 'nameLower', 'endsAt',
            'currentBid', 'bidCount', 'minIncrement', 'status', 'winnerId',
            'sellerName', 'sellerPhoto', 'createdAt'])
          && d['User Id'] == request.auth.uid
          && d['Product Name'] is string
          && d['Product Name'].size() > 0 && d['Product Name'].size() <= 200
          && d['Product Description'] is string
          && d['Product Description'].size() <= 10000
          && d.get('nameLower', '') == d['Product Name'].lower()
          && validEndsAt(d.endsAt)
          && validImageUrl(d['Image Url'], request.auth.uid)
          && d.currentBid is number && d.currentBid >= 0
          && d.minIncrement is number && d.minIncrement > 0
          && d.bidCount == 0
          && d.status == 'active'
          && d.get('winnerId', null) == null
          && d.get('sellerName', '') is string
          && d.get('sellerPhoto', '') is string
          && d.createdAt == request.time;
      }

      // Placing a bid. Must be written in the same transaction as the bid doc
      // `bids/{productId}_{newBidCount}`, whose bidder and amount must match.
      function isBidUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let prevCount = before.get('bidCount', 0);
        let prevBid = before.get('currentBid', 0);
        let bid = bidPath(productId + '_' + string(prevCount + 1));
        return after.diff(before).affectedKeys()
            .hasOnly(['currentBid', 'bidCount', 'highestBidderId'])
          && before.get('status', 'active') == 'active'
          && before.get('endsAt', null) is timestamp
          && request.time < before.endsAt
          && request.auth.uid != before['User Id']
          && after.highestBidderId == request.auth.uid
          && after.bidCount == prevCount + 1
          && after.currentBid is number
          && after.currentBid > prevBid
          && (prevCount == 0
              || after.currentBid >= prevBid + before.get('minIncrement', 1))
          && existsAfter(bid)
          && getAfter(bid).data['Bidder Id'] == request.auth.uid
          && getAfter(bid).data['Bid Amount'] == after.currentBid;
      }

      // Seller edits description / end date / price / photo / increment,
      // only on an active auction that has no bids.
      function isSellerEdit() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        return request.auth.uid == before['User Id']
          && before.get('status', 'active') == 'active'
          && before.get('bidCount', 0) == 0
          && after.get('bidCount', 0) == 0
          && changed.hasOnly([
               'Product Description', 'Date', 'Minimum Bid Price', 'endsAt',
               'currentBid', 'Image Url', 'minIncrement'])
          && (!('endsAt' in changed) || validEndsAt(after.endsAt))
          && (!('Image Url' in changed)
              || validImageUrl(after['Image Url'], request.auth.uid))
          && (!('currentBid' in changed)
              || (after.currentBid is number && after.currentBid >= 0))
          && (!('minIncrement' in changed)
              || (after.minIncrement is number && after.minIncrement > 0))
          && (!('Product Description' in changed)
              || (after['Product Description'] is string
                  && after['Product Description'].size() <= 10000));
      }
    }

    // ── Bids ─────────────────────────────────────────────────────────────────
    // Bid id is `{productId}_{bidCount}` and the doc must be created in the
    // same transaction as the matching product update (isBidUpdate), so a bid
    // can't exist without actually becoming the product's current high bid.
    match /bids/{bidId} {
      allow read: if signedIn();
      allow create: if signedIn() && isValidBid();
      allow update, delete: if false;

      function isValidBid() {
        let bid = request.resource.data;
        let product = productPath(bid['Product Id']);
        let before = get(product).data;
        let after = getAfter(product).data;
        return bid.keys().hasOnly(
              ['Bidder Id', 'Product Id', 'Bid Amount', 'Bid Time', 'Created At'])
          && bid['Bidder Id'] == request.auth.uid
          && bid['Bid Amount'] is number
          && bid['Created At'] == request.time
          && after.bidCount == before.get('bidCount', 0) + 1
          && bidId == bid['Product Id'] + '_' + string(after.bidCount)
          && after.highestBidderId == request.auth.uid
          && after.currentBid == bid['Bid Amount'];
      }
    }

    // ── Watchlist ─────────────────────────────────────────────────────────────
    // Doc id is `{uid}_{productId}` so an entry can't be duplicated. Updates
    // only let the owner re-write the same entry (an idempotent re-add).
    match /watchlist/{entryId} {
      allow read: if signedIn()
        && resource.data['User Id'] == request.auth.uid;
      allow create: if signedIn() && validWatchlistEntry();
      allow update: if signedIn() && validWatchlistEntry()
        && resource.data['User Id'] == request.auth.uid;
      allow delete: if signedIn()
        && resource.data['User Id'] == request.auth.uid;

      function validWatchlistEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['User Id', 'Product Id', 'Added At'])
          && d['User Id'] == request.auth.uid
          && d['Product Id'] is string
          && entryId == request.auth.uid + '_' + d['Product Id'];
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    // Created only by Cloud Functions. The owner may mark one read or delete it.
    match /notifications/{uid}/items/{itemId} {
      allow read, delete: if isUser(uid);
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create: if false;
    }

    // ── Follows ───────────────────────────────────────────────────────────────
    // A follower subscribes to a seller's new auctions. Doc id is
    // `{followerId}_{sellerId}` to keep the pair unique.
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerId', 'sellerId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.sellerId;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }
  }
}
